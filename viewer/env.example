# Copy to .env in this directory, then chmod 600 .env.
# Directory values are container destinations for the two read-only binds.
# Leave unused basemap keys empty. Do not put live URLs or credentials in Git.

YD_VIEWER_INPUT_DIR=/input
YD_VIEWER_OUTPUT_DIR=/output
YD_VIEWER_PORT=18080
YD_BASEMAP_VECTOR_URL=
YD_BASEMAP_SATELLITE_URL=
YD_BASEMAP_TERRAIN_URL=
YD_BASEMAP_VECTOR_ANNOTATION_URL=
YD_BASEMAP_SATELLITE_ANNOTATION_URL=
YD_BASEMAP_TERRAIN_ANNOTATION_URL=
